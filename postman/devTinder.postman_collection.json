{
  "info": {
    "name": "devTinder API",
    "description": "Collection for testing devTinder endpoints: signup, login, profile, feed, connection requests, chat, payments.\n\nAuth is cookie-based (JWT stored in an httpOnly cookie named `token`). Postman's cookie jar handles this automatically as long as requests are sent to the same `baseUrl` and 'Automatically follow redirects' / cookie handling is enabled (default).\n\nSuggested flow:\n1. Run 'Signup User1' and 'Signup User2' (or 'Login User1' / 'Login User2' if they already exist) - this sets the `token` cookie for whichever user you logged in last.\n2. Run 'Get Feed' while logged in as User1 to find User2's `_id`, then set the `targetUserId` collection variable to it.\n3. Run 'Send Request - Interested' as User1 targeting User2.\n4. Log in as User2 ('Login User2'), run 'Get Received Requests' to find the request's `_id`, set `requestId` variable, then run 'Review Request - Accept'.\n\nNote: Postman keeps one cookie jar per domain, so switching between User1 and User2 means re-running the Login request for whichever user you want to act as right before the next call.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:7777",
      "type": "string"
    },
    {
      "key": "targetUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "requestId",
      "value": "",
      "type": "string"
    },
    {
      "key": "messageCursor",
      "value": "",
      "type": "string"
    },
    {
      "key": "unconnectedUserId",
      "value": "",
      "type": "string"
    },
    {
      "key": "postImageKey",
      "value": "",
      "description": "The `key` returned by POST /posts/upload-url"
    },
    {
      "key": "postId",
      "value": "",
      "description": "A post _id from GET /posts/feed"
    },
    {
      "key": "postCursor",
      "value": "",
      "description": "nextCursor from a previous GET /posts/feed"
    }
  ],
