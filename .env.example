# Copy to .env and fill in real values. .env itself is gitignored.

# --- Core ---
DB_CONNECTION_SECRET=mongodb://localhost:27017/devTinder
PORT=7777
JWT_SECRET=change-me

# --- Phase 0 infra (see docker-compose.yml) ---

# Redis (BullMQ queue, rate limiter, Socket.io adapter)
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO locally; real S3 in prod).
# Leave S3_ENDPOINT unset in prod to talk to real AWS S3.
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=now-connect-posts
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# --- Optional: external providers used by existing features ---
# AWS_ACCESS_KEY=
# AWS_SECRET_KEY=
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
